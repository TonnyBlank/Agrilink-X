# AgriLink X Backend

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:8080

# M-Pesa Sandbox / Live
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://your-public-backend-url/api/payments/mpesa/callback
MPESA_MOCK_MODE=true

# Optional: JWT secret if validating tokens manually
# (Supabase auth is validated via user JWTs)
